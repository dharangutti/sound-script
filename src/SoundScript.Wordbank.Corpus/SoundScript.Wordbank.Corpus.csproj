<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SoundScript.Wordbank.Corpus</RootNamespace>
    <AssemblyName>SoundScript.Wordbank.Corpus</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\SoundScript.Wordbank\Data\corpus\**\*.wav"
                      LogicalName="Corpus/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
