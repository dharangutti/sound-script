<div class="demo-page">
    <header class="demo-header">
        <nav class="demo-nav" aria-label="Primary navigation">
            <a href="/playground">Playground</a>
            <a href="https://soundscript.net/doc.html?p=user-guide.md">Docs</a>
            <a href="https://github.com/dharangutti/sound-script">GitHub</a>
        </nav>
        <a class="demo-brand" href="/" aria-label="SoundScript home">
            <img src="assets/soundscript-logo.png" alt="SoundScript" />
        </a>
        <div class="demo-badge">SoundScript Web Demo · @VersionInfo.Label</div>
        <h1>Programmable sound, from score to media</h1>
        <p class="demo-lead">Write a melody below, generate deterministic MIDI, and download — all in your browser.</p>
        <p class="demo-lead">For full examples, Wave audio, vocals, and the temporal visual program, open the <a href="/playground">Playground</a>.</p>
    </header>

    <section class="demo-feature" aria-labelledby="temporal-feature-title">
        <span class="demo-feature-kicker">New in @VersionInfo.Label</span>
        <h2 id="temporal-feature-title">Temporal audio-visual programs</h2>
        <p>Author visuals as deterministic <code>StateAt(t)</code> intervals and curves—not frames—then export a synchronized WebM clip from the Visual Timeline tab. Output FPS belongs to the renderer, never the language.</p>
        <a class="btn btn-outline-primary" href="/playground">Explore Visual Timeline →</a>
    </section>

    <div class="demo-presets">
        <span class="preset-label">Examples:</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMelodyExample">Melody</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadDurationsExample">Durations</button>
    </div>

    <div class="demo-editor">
        <label for="script-input" class="demo-label">SoundScript</label>
        <textarea id="script-input"
                  class="demo-textarea"
                  @bind="ScriptText"
                  rows="14"
                  spellcheck="false"
                  placeholder="melody { ... }"></textarea>
    </div>

    <div class="demo-actions">
        <button class="btn btn-primary btn-lg" @onclick="Generate">Generate MIDI</button>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="demo-error" role="alert">@ErrorMessage</div>
    }

    @if (MidiBytes != null)
    {
        <div class="demo-success">
            <span>MIDI ready — @MidiBytes.Length bytes</span>
            <a class="btn btn-success"
               href="data:audio/midi;base64,@Convert.ToBase64String(MidiBytes)"
               download="soundscript.mid">
                Download MIDI
            </a>
        </div>
    }
</div>
