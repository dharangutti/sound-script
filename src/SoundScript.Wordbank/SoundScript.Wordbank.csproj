<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SoundScript.Wordbank</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\**\*.json" Exclude="Data\corpus\**\*" />
    <EmbeddedResource Include="Data\corpus\**\*.json" LogicalName="Corpus/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="Data\corpus\**\*" CopyToOutputDirectory="PreserveNewest" Link="Data\corpus\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundScript.Wordbank.Corpus\SoundScript.Wordbank.Corpus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SoundScript.Tests" />
  </ItemGroup>

</Project>
