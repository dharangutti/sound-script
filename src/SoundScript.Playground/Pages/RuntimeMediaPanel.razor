@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

<details class="runtime-panel" data-testid="runtime-panel" open>
    <summary><strong>Adaptive media — runtime parameters</strong></summary>
    <p>Try <strong>Normal → Warning → Critical</strong>: the indicator moves and brightens while the same melody becomes louder. Each state updates the preview immediately; press Play below to hear it.</p>
    <p class="hint">Runtime values apply without recompiling. One stable snapshot supplies the complete WAV and visual state; the animated preview follows the audio playback clock. Edit the source and compile to create your own controls.</p>
    <div class="runtime-grid">
    <section class="runtime-authoring" aria-label="Runtime authoring">
        <div class="runtime-toolbar">
            <label for="runtime-source">SoundScript source</label>
            <span class="hint">@source.Split('\n').Length lines</span>
        </div>
        <textarea id="runtime-source" class="script-input runtime-source" data-testid="runtime-source" rows="16" spellcheck="false" autocapitalize="off" aria-describedby="runtime-source-help" value="@source" @oninput="SourceChanged"></textarea>
        <p id="runtime-source-help" class="hint">Source edits clear the preview. Compile again to use the new source.</p>
        <div class="runtime-toolbar">
            <button type="button" class="btn btn-primary" @onclick="Compile" data-testid="runtime-compile">Compile</button>
            <button type="button" class="btn btn-secondary" @onclick="LoadExample" data-testid="runtime-example">Load monitoring example</button>
            <button type="button" class="btn btn-secondary" @onclick="LoadGeometry" data-testid="runtime-geometry">Explore all visual parameters</button>
        </div>
    </section>
    <section class="runtime-output" aria-label="Runtime values and preview">
    @if (session.Runtime is { } runtime)
    {
        @if (source == RuntimeMediaSession.MonitoringSource)
        {
            <div class="runtime-presets" role="group" aria-label="Monitoring states">
                <button type="button" class="btn btn-secondary" data-testid="runtime-normal" aria-pressed="@MonitoringSelected(0.25m, 200m)" @onclick="() => ApplyMonitoring(0.25m, 200m)">Normal · quiet / left</button>
                <button type="button" class="btn btn-secondary" data-testid="runtime-warning" aria-pressed="@MonitoringSelected(0.55m, 640m)" @onclick="() => ApplyMonitoring(0.55m, 640m)">Warning · medium / center</button>
                <button type="button" class="btn btn-secondary" data-testid="runtime-critical" aria-pressed="@MonitoringSelected(0.9m, 1080m)" @onclick="() => ApplyMonitoring(0.9m, 1080m)">Critical · loud / right</button>
            </div>
        }
        @if (runtime.Parameters.Count > 0)
        {
        <fieldset class="runtime-values" data-testid="runtime-controls">
            <legend>Parameter values</legend>
            @foreach (var parameter in runtime.Parameters)
            {
                <div class="runtime-value">
                    <label for="runtime-@parameter.Name">@parameter.Name (@parameter.Minimum.ToString(CultureInfo.InvariantCulture) to @parameter.Maximum.ToString(CultureInfo.InvariantCulture))</label>
                    <input id="runtime-@parameter.Name" data-testid="runtime-value-@parameter.Name" inputmode="decimal" aria-describedby="runtime-default-@parameter.Name" value="@inputs[parameter.Name]" @oninput="e => inputs[parameter.Name] = e.Value?.ToString() ?? string.Empty" />
                    <small id="runtime-default-@parameter.Name">Default: @parameter.Default.ToString(CultureInfo.InvariantCulture)</small>
                </div>
            }
            <div class="runtime-toolbar">
                <button type="button" class="btn btn-primary" @onclick="Apply" data-testid="runtime-apply">Apply state</button>
                <button type="button" class="btn btn-secondary" @onclick="Reset" data-testid="runtime-reset">Reset values</button>
            </div>
        </fieldset>
        }
        else { <p data-testid="runtime-empty">No runtime parameters declared. This preview uses fixed source values.</p> }
        <p role="status" data-testid="runtime-status" data-parse-count="@runtime.Statistics.Parses">Rendered snapshot @runtime.Revision · Compiled @runtime.Statistics.Parses time(s). @feedback</p>
        <p class="hint" data-testid="runtime-applied">Applied: @string.Join(" · ", runtime.Parameters.Select(p => $"{p.Name} = {runtime.Get(p.Name).ToString(CultureInfo.InvariantCulture)}"))</p>
    }
    @if (error is not null) { <p class="runtime-error" role="alert" data-testid="runtime-error">@error</p> }
    @if (session.Audio.Length > 0)
    {
        <audio @key="generation" @ref="audioElement" controls aria-label="Rendered runtime audio" data-testid="runtime-audio" src="@audioUrl"></audio>
        <a href="@audioUrl" download="runtime.wav">Download WAV</a>
        <div class="runtime-scene" data-testid="runtime-scene" data-time="@visualTime.ToString(CultureInfo.InvariantCulture)" aria-label="Rendered runtime scene">@((MarkupString)currentSvg)</div>
    }
    else if (session.Runtime is null && error is null) { <p class="hint">Compile the source to discover its parameters and preview media here.</p> }
    </section>
    </div>
</details>

@code {
    private ElementReference audioElement;
    private IJSObjectReference? module;
    private IJSObjectReference? clock;
    private DotNetObjectReference<RuntimeMediaPanel>? callback;
    private long generation;
    private long attachedGeneration = -1;
    private bool disposed;
    private string currentSvg = "";
    private double visualTime;
    private readonly SemaphoreSlim clockLifecycle = new(1, 1);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Rendering can re-enter while JS interop is awaited. Serialize attachment and cleanup.
        await clockLifecycle.WaitAsync();
        try
        {
            if (disposed || attachedGeneration == generation) return;
            module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./runtime-media.js");
            if (clock is not null)
            {
                await clock.InvokeVoidAsync("dispose");
                await clock.DisposeAsync();
                clock = null;
            }
            attachedGeneration = generation;
            if (session.Audio.Length == 0 || disposed) return;
            callback ??= DotNetObjectReference.Create(this);
            clock = await module.InvokeAsync<IJSObjectReference>("attach", audioElement, callback, generation);
        }
        finally { clockLifecycle.Release(); }
    }
    [JSInvokable]
    public void UpdateAudioTime(long version, double seconds)
    {
        if (disposed || version != generation || session.Snapshot is null || !double.IsFinite(seconds)) return;
        currentSvg = session.SvgAt(seconds);
        visualTime = seconds;
        StateHasChanged();
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await clockLifecycle.WaitAsync();
        try
        {
            if (clock is not null) { await clock.InvokeVoidAsync("dispose"); await clock.DisposeAsync(); }
            callback?.Dispose();
            if (module is not null) await module.DisposeAsync();
        }
        finally { clockLifecycle.Release(); }
    }
    private readonly RuntimeMediaSession session = new();
    private readonly Dictionary<string, string> inputs = new(StringComparer.Ordinal);
    private string source = RuntimeMediaSession.MonitoringSource;
    private string? error;
    private string audioUrl = "";
    private string feedback = "";
    protected override void OnInitialized() => Compile();
    private void SourceChanged(ChangeEventArgs e) { source = e.Value?.ToString() ?? ""; Clear(); }
    private void Clear() { session.Clear(); inputs.Clear(); audioUrl = ""; error = null; generation++; currentSvg = ""; visualTime = 0; }
    private void LoadExample() { source = RuntimeMediaSession.MonitoringSource; Compile(); }
    private void LoadGeometry() { source = RuntimeMediaSession.GeometrySource; Compile(); }
    private void Compile() => Act(() => { session.Compile(source); RefreshInputs(); feedback = "Defaults rendered. Change values and apply, then press Play."; });
    private void Apply() => Act(() => { var revision = session.Runtime!.Revision; session.Apply(inputs); feedback = session.Runtime.Revision == revision ? "Values unchanged." : "State updated without recompiling. Press Play to hear this snapshot."; });
    private void Reset() => Act(() => { session.Reset(); RefreshInputs(); feedback = "Defaults restored. Press Play to compare."; });
    private string MonitoringSelected(decimal intensity, decimal xpos) => session.Runtime!.Get("intensity") == intensity && session.Runtime.Get("xpos") == xpos ? "true" : "false";
    private void ApplyMonitoring(decimal intensity, decimal xpos) => Act(() =>
    {
        session.Apply(new Dictionary<string, string>
        {
            ["intensity"] = intensity.ToString(CultureInfo.InvariantCulture),
            ["xpos"] = xpos.ToString(CultureInfo.InvariantCulture)
        });
        RefreshInputs();
        feedback = "Monitoring state applied. Press Play to compare the volume.";
    });
    private void RefreshInputs()
    {
        inputs.Clear();
        foreach (var p in session.Runtime!.Parameters) inputs[p.Name] = session.Runtime.Get(p.Name).ToString(CultureInfo.InvariantCulture);
    }
    private void Act(Action action)
    {
        try { error = null; action(); audioUrl = "data:audio/wav;base64," + Convert.ToBase64String(session.Audio); generation++; currentSvg = session.Svg; visualTime = 0; }
        catch (Exception ex) { error = ex.Message; if (session.Runtime is null) { inputs.Clear(); audioUrl = ""; generation++; currentSvg = ""; visualTime = 0; } }
    }
}
