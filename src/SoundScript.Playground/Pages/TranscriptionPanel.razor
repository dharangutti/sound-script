@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SoundScript.Transcription
@using SoundScript.Wave
@using SoundScript.Midi
@using SoundScript.Parser
@inject IJSRuntime Js

<div class="transcription-workspace">
    <h2>Transcribe music</h2>
    <p>Import a melody, piano, mixture or percussion recording, edit the generated SoundScript, and hear it reconstructed. Audio stays in this browser.</p>
    <p>WAV is recommended. MP3 and video support depend on browser codecs; the CLI supports FFmpeg. Maximum 64 MiB / 120 seconds. Choose Monophonic for solo melodies or try experimental extraction for complex audio.</p>
    <label for="transcription-mode">Analysis mode</label>
    <select id="transcription-mode" @bind="mode" @bind:after="ModeChanged" disabled="@busy">
        <option value="Monophonic">Monophonic</option>
        <option value="ExtractMelody">Extract Melody from Complex Audio (Experimental)</option>
        <option value="Polyphonic">Polyphonic / Piano (Experimental)</option>
        <option value="Percussion">Percussion / Rhythm (Experimental)</option>
        <option value="Mixed">Mixed Audio / Roles (Experimental)</option>
    </select>
    <p>@(mode == TranscriptionMode.Percussion ? "Detects unpitched transients and estimates kick/snare/hat or generic percussion. No drum resonances are converted into pitched notes. Playback uses a synthetic kit." : mode == TranscriptionMode.Mixed ? "Estimates symbolic melody, harmony and bass roles from supported pitches. These are not isolated stems; percussion and diffuse sections are omitted." : mode == TranscriptionMode.Polyphonic ? "Attempts simultaneous piano pitches and overlapping notes in parallel voices. Dense mixtures and uncertain harmonics may be rejected; this is experimental, not an exact score." : mode == TranscriptionMode.Monophonic ? "One clean solo line; simultaneous sources are unsupported." : "Attempts only one dominant line and discards accompaniment. Ambiguous sections may be rejected. Output is experimental, not exact transcription.")</p>
    @if (mode == TranscriptionMode.Mixed)
    {
        <fieldset><legend>Roles to reconstruct</legend>
            <label><input id="role-melody" type="checkbox" @bind="includeMelody" @bind:after="InvalidateResult" disabled="@busy" /> Melody</label>
            <label><input id="role-harmony" type="checkbox" @bind="includeHarmony" @bind:after="InvalidateResult" disabled="@busy" /> Harmony</label>
            <label><input id="role-bass" type="checkbox" @bind="includeBass" @bind:after="InvalidateResult" disabled="@busy" /> Bass</label>
        </fieldset>
    }
    @if (originalUrl != null)
    {
        <label for="transcription-original">Original recording (full file; excerpt times below)</label>
        <audio id="transcription-original" controls src="@originalUrl" preload="metadata"></audio>
        <button class="btn btn-secondary" disabled="@(busy || media == null)" @onclick="PlayOriginalExcerpt">Play original excerpt</button>
    }
    <label for="transcription-file">Media file</label>
    <InputFile id="transcription-file" OnChange="SelectFile" accept="audio/*,video/mp4,video/webm,.wav,.mp3,.mp4,.m4a,.webm" disabled="@busy" />
    @if (media != null)
    {
        <p>Detected media duration: @media.DurationSeconds.ToString("F3") seconds. Supported maximum: 120 seconds per analysis. Decoded: @media.SampleRate Hz, @media.Channels channels; analysis: mono 16000 Hz.</p>
        @if (media.DurationSeconds > 120) { <p role="alert">This recording exceeds the 120-second limit. Select an excerpt below before analysis.</p> }
        <label for="transcription-start">Excerpt start (seconds)</label>
        <input id="transcription-start" type="number" min="0" step="0.1" @bind="excerptStart" @bind:after="InvalidateResult" disabled="@busy" />
        <label for="transcription-duration">Excerpt duration (seconds, maximum 120; blank to end)</label>
        <input id="transcription-duration" type="number" min="0.01" max="120" step="0.1" @bind="excerptDuration" @bind:after="InvalidateResult" disabled="@busy" />
    }
    <label for="transcription-tempo">Tempo (blank for automatic estimate)</label>
    <input id="transcription-tempo" type="number" min="20" max="300" @bind="tempo" @bind:after="InvalidateResult" disabled="@busy" />
    <label for="transcription-instrument">Playback instrument</label>
    <select id="transcription-instrument" @bind="instrument" @bind:after="InvalidateResult" disabled="@(busy || mode == TranscriptionMode.Percussion)">
        @if (mode == TranscriptionMode.Percussion) { <option value="@instrument">Synthetic percussion kit</option> }
        else { <option value="73">Flute</option><option value="0">Piano</option><option value="40">Violin</option><option value="80">Synth lead</option> }
    </select>
    <div class="playground-playbar">
        <button class="btn btn-primary" disabled="@(busy || media == null)" @onclick="Analyze">@(busy ? "Working…" : "Analyze / Transcribe")</button>
        @if (busy) { <button class="btn btn-secondary" @onclick="Cancel">Cancel analysis</button> }
        <button class="btn btn-primary" disabled="@(!CanUseSource)" @onclick="Play">Play edited source</button>
        <button class="btn btn-secondary" @onclick="Stop">Stop</button>
        <button class="btn btn-secondary" disabled="@(!CanUseSource)" @onclick="ExportSource">Export SoundScript</button>
        <button class="btn btn-secondary" disabled="@(!CanUseSource)" @onclick="ExportWave">Export WAV</button>
        <button class="btn btn-secondary" disabled="@(busy || result == null)" @onclick="ExportReport">Export analysis</button>
    </div>
    @if (error != null) { <p role="alert">@error</p> }
    <p role="status" aria-live="polite">@status</p>
    @if (result != null)
    {
        <p><strong>@result.Suitability.Status</strong>: @result.Suitability.Reason</p>
        @if (result.Mixed is { } mixed)
        {
            <p>@mixed.SeparationKind. Unsupported/rejected frames: @mixed.UnsupportedFrameFraction.ToString("P1").</p>
            @foreach (var role in mixed.Roles)
            {
                <p>@role.Role: @role.DetectedNotes observed notes; @(role.Selected ? "selected" : "disabled"). @role.Method</p>
                <button class="btn btn-secondary" disabled="@(!CanUseSource || !role.Selected || role.DetectedNotes == 0)" @onclick="() => PlayRole(role.Role)">Play analyzed @role.Role</button>
            }
        }
        @if (result.Percussion is { } percussion)
        {
            <p>@percussion.Hits.Count detected hits · Tempo hypothesis @result.Score.TempoMap[0].Bpm BPM · Timing grid fit @result.TimingGridFit.ToString("P1"). Grid origin @percussion.GridOriginSeconds.ToString("F2") seconds.</p>
            <p>Tempo alternatives: @string.Join(", ", percussion.TempoAlternatives.Select(t => $"{t.Bpm} BPM ({t.GridFit:P0} fit)")).</p>
            <p>@percussion.ClassificationMeaning Rejected candidates: @percussion.RejectedTransients.</p>
            <details><summary>Detected hits and classification evidence</summary>
                <ul>@foreach (var hit in percussion.Hits) { <li>@hit.StartSeconds.ToString("F2") s · beat @hit.StartBeat.ToString("F2") · @hit.Sound · classification score @hit.Classification.Confidence.ToString("P0") · onset strength @hit.OnsetStrength.ToString("P0"). @hit.Classification.Method</li> }</ul>
            </details>
        }
        else if (result.Polyphony is { } poly)
        {
            <p>@poly.DetectedNotes detected notes; maximum simultaneous notes @poly.MaximumSimultaneousNotes; @poly.ChordCount simultaneous pitch groups (observed chords, not named chord recognition); mean active polyphony @poly.MeanActivePolyphony.ToString("F2").</p>
            <p>Polyphonic coverage @poly.PolyphonicCoverage.ToString("P1"); stable active coverage @poly.StableActiveCoverage.ToString("P1"); residual fundamental energy share @poly.MeanFundamentalShare.ToString("P1"); rejected/ambiguous frames @poly.AmbiguousFrameFraction.ToString("P1"); octave ambiguity @poly.OctaveAmbiguousFraction.ToString("P1"). Energy and frame fractions are not accuracy probabilities.</p>
        }
        else if (result.Extraction is { } extraction)
        {
            <p>@extraction.ExtractedNoteCount extracted notes; melody coverage @extraction.MelodyCoverage.ToString("P1"); mean spectral share @extraction.MeanSpectralShare.ToString("P1"); competing-pitch ambiguity @extraction.CompetingPitchFraction.ToString("P1"); octave uncertainty @extraction.OctaveUncertainFraction.ToString("P1"). These are measured energy/frame fractions, not accuracy probabilities.</p>
            <details><summary>@extraction.RejectedSections.Count rejected sections</summary>
                <ul>@foreach (var section in extraction.RejectedSections) { <li>@section.StartSeconds.ToString("F2")–@section.EndSeconds.ToString("F2") s (relative to excerpt): @section.Reason</li> }</ul>
            </details>
        }
        else
        {
        <p>@result.Suitability.UsableNotes usable candidates. Stable supported coverage of active audio: @result.Suitability.StableActiveFraction.ToString("P1"); voiced coverage: @result.Suitability.VoicedActiveFraction.ToString("P1"); active-audio periodicity: @result.Suitability.ActivePeriodicity.ToString("P1"); fundamental support: @result.Suitability.FundamentalSupportedFraction.ToString("P1"). Detected fragments are not a verified melody.</p>
        }
        @if (result.Percussion == null) { <p>@result.Score.Tracks.Sum(t => t.Notes.Count) notes · Tempo hypothesis @result.Score.TempoMap[0].Bpm BPM · @(result.Polyphony != null ? "Residual fundamental share" : result.Extraction == null ? "Pitch periodicity" : "Selected spectral share") @result.PitchConfidence.ToString("P1") · Timing grid fit @result.TimingGridFit.ToString("P1")</p> }
        <ul>@foreach (var diagnostic in result.Diagnostics) { <li>@diagnostic.Message</li> }</ul>
        @if (percussionComparison != null) { <p>Reconstruction check: onset precision @percussionComparison.OnsetPrecision.ToString("P1"), recall @percussionComparison.OnsetRecall.ToString("P1"), class agreement @percussionComparison.MatchedClassAgreement.ToString("P1"). Synthetic-playback reanalysis does not establish source accuracy.</p> }
        @if (polyphonicComparison != null) { <p>Reconstruction check: note precision @polyphonicComparison.NotePrecision.ToString("P1"), recall @polyphonicComparison.NoteRecall.ToString("P1"), @polyphonicComparison.MissedNotes missed, @polyphonicComparison.ExtraNotes extra notes. Generated-score reanalysis does not establish source accuracy.</p> }
        @if (comparison != null) { <p>Reconstruction check: pitch recall @comparison.PitchAccuracy.ToString("P1"), @comparison.MissedNotes missed, @comparison.ExtraNotes extra notes. This compares the generated score to its rendered audio; it does not prove source accuracy.</p> }
    }
    <label for="transcription-source">Editable SoundScript</label>
    <textarea id="transcription-source" class="transcription-source" rows="18" spellcheck="false" @bind="source" @bind:event="oninput" disabled="@busy"></textarea>
</div>

@code {
    private IBrowserFile? file;
    private TranscriptionMode mode;
    private bool includeMelody = true, includeHarmony = true, includeBass = true;
    private string[] SelectedRoles => new[] { includeMelody ? "melody" : null, includeHarmony ? "harmony" : null, includeBass ? "bass" : null }.OfType<string>().ToArray();
    private string? originalUrl;
    private int? tempo;
    private int instrument = 73;
    private bool busy;
    private string source = "";
    private string? status, error;
    private TranscriptionResult? result;
    private ComparisonMetrics? comparison;
    private PercussionMetrics? percussionComparison;
    private PolyphonicMetrics? polyphonicComparison;
    private CancellationTokenSource? cancellation;
    private MediaInfo? media;
    private byte[]? inputBytes;
    private bool nativeWave, generated;
    private double excerptStart;
    private double? excerptDuration;
    private bool CanUseSource => !busy && generated && !string.IsNullOrWhiteSpace(source);
    private void InvalidateResult() { generated = false; result = null; comparison = null; polyphonicComparison = null; percussionComparison = null; error = null; status = "Selection changed. Analyze again; previous editor text is inactive."; }
    private void ModeChanged() { if (mode is TranscriptionMode.Polyphonic or TranscriptionMode.Mixed) instrument = 0; InvalidateResult(); }
    private void Cancel() => cancellation?.Cancel();

    private async Task SelectFile(InputFileChangeEventArgs args)
    {
        file = args.File; originalUrl = null; InvalidateResult(); media = null; inputBytes = null; nativeWave = false;
        error = null; busy = true; excerptStart = 0; excerptDuration = null; status = "Reading media duration…";
        try
        {
            await Stop();
            await Js.InvokeVoidAsync("SoundScriptTranscription.clear");
            using var input = file.OpenReadStream(64 * 1024 * 1024);
            using var memory = new MemoryStream(); await input.CopyToAsync(memory); inputBytes = memory.ToArray();
            if (Path.GetExtension(file.Name).Equals(".wav",StringComparison.OrdinalIgnoreCase))
            {
                try { PcmWaveInput.Decode(inputBytes,new(0,.00001),value => media = value); nativeWave = true; }
                catch (NotSupportedException) { }
            }
            if (!nativeWave) media = await Js.InvokeAsync<MediaInfo>("SoundScriptTranscription.inspect",inputBytes);
            originalUrl = await Js.InvokeAsync<string>("SoundScriptTranscription.sourceUrl", inputBytes, file.ContentType);
            status = "Media ready. Choose an excerpt if needed, then analyze.";
        }
        catch (Exception ex) { media = null; error = ex.Message.Split('\n')[0]; status = "Media could not be prepared. Playback and export are inactive."; }
        finally { busy = false; }
    }
    private async Task Analyze()
    {
        if (file == null || media == null || inputBytes == null || busy) return;
        busy = true; error = null; status = "Decoding and analyzing music…";
        result = null; comparison = null; polyphonicComparison = null; percussionComparison = null; generated = false;
        cancellation?.Dispose(); cancellation = new CancellationTokenSource();
        try
        {
            await Stop();
            await Task.Yield();
            var excerpt = new MediaExcerpt(excerptStart,excerptDuration);
            double duration = excerpt.Validate(media.DurationSeconds);
            AnalysisAudio audio = nativeWave ? PcmWaveInput.Decode(inputBytes,excerpt) : await DecodeBrowser(excerptStart,duration);
            result = await new TranscriptionEngine().TranscribeAsync(audio, new(tempo, instrument) { Roles = mode == TranscriptionMode.Mixed ? SelectedRoles : null }, mode, cancellation.Token);
            if (!result.Suitability.CanGenerate) { status = "Transcription rejected. No source generated; playback and source/WAV export are inactive. You can export the analysis diagnostics."; return; }
            status = "Rendering and checking the reconstruction…"; StateHasChanged();
            if (result.Percussion != null)
            {
                var validation = await PercussionComparison.ValidateAsync(TranscriptionSuitability.ScoreForGeneration(result), cancellation.Token);
                source = validation.Source; percussionComparison = validation.ScoreToRenderedAudio;
            }
            else if (result.Polyphony != null)
            {
                var validation = await PolyphonicComparison.ValidateAsync(TranscriptionSuitability.ScoreForGeneration(result), cancellation.Token);
                source = validation.Source; polyphonicComparison = validation.ScoreToRenderedAudio;
            }
            else
            {
                var validation = await MusicalComparison.ValidateAsync(TranscriptionSuitability.ScoreForGeneration(result), cancellation.Token);
                source = validation.Source; comparison = validation.ScoreToRenderedAudio;
            }
            cancellation.Token.ThrowIfCancellationRequested(); generated = true;
            status = result.Percussion != null ? "Experimental rhythm estimate. Review hit timing and coarse classes against the original; playback uses a synthetic kit." : result.Mixed != null ? "Experimental role reconstruction. Review the role assignments; they do not establish isolated sources or instrumental identity." : result.Polyphony != null ? "Experimental polyphonic result. Review simultaneous notes, sustain and harmonics against the original excerpt before exporting." : result.Suitability.Status == "Experimental" ? "Experimental partial result. Review every note before using or exporting; accompaniment is not reproduced." : "Ready. Play, edit the source, and play again. Analysis describes the original import.";
        }
        catch (OperationCanceledException) { status = "Analysis cancelled; your editor text is preserved."; }
        catch (Exception ex) { error = ex.Message.Split('\n')[0]; status = "Transcription failed; previous editor text is preserved but playback and export are inactive."; }
        finally { busy = false; }
    }
    private async Task<AnalysisAudio> DecodeBrowser(double start, double duration)
    {
        await using var reference = await Js.InvokeAsync<IJSStreamReference>("SoundScriptTranscription.excerpt", start, duration);
        await using var stream = await reference.OpenReadStreamAsync(AnalysisAudio.SampleRate * AnalysisAudio.MaximumSeconds * 4L);
        using var memory = new MemoryStream(); await stream.CopyToAsync(memory);
        var data = memory.ToArray();
        if (data.Length % 4 != 0) throw new InvalidDataException("Partial PCM data returned by browser.");
        var samples = new float[data.Length / 4]; Buffer.BlockCopy(data, 0, samples, 0, data.Length);
        return new(samples);
    }
    private async Task PlayRole(string role)
    {
        if (!CanUseSource || result?.Mixed == null) return;
        busy = true; error = null;
        try
        {
            await Stop(); await Task.Yield();
            var score = result.Score with { Tracks = result.Score.Tracks.Where(t => t.Role == role).ToArray() };
            var bytes = TranscriptionPlayback.Render(new SoundScriptOutput().Source(score));
            await Js.InvokeVoidAsync("SoundScriptAudio.playWavBytes", bytes);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }
    private async Task PlayOriginalExcerpt()
    {
        if (media == null || busy) return;
        try
        {
            error = null; await Stop();
            double duration = new MediaExcerpt(excerptStart, excerptDuration).Validate(media.DurationSeconds);
            await Js.InvokeVoidAsync("SoundScriptTranscription.playOriginalExcerpt", excerptStart, duration);
        }
        catch (Exception ex) { error = ex.Message.Split('\n')[0]; }
    }
    private async Task Play() { await Stop(); await WithSource(async bytes => await Js.InvokeVoidAsync("SoundScriptAudio.playWavBytes", bytes)); }
    private async Task ExportWave() => await WithSource(async bytes => await Js.InvokeVoidAsync("SoundScriptAudio.download", Convert.ToBase64String(bytes), "transcription.wav"));
    private async Task WithSource(Func<byte[], Task> action)
    {
        if (!CanUseSource) return; busy = true; error = null;
        try { await Task.Yield(); var bytes = TranscriptionPlayback.Render(source); await action(bytes); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }
    private async Task Stop()
    {
        await Js.InvokeVoidAsync("SoundScriptAudio.stop");
        await Js.InvokeVoidAsync("SoundScriptTranscription.stopOriginal");
    }
    public async ValueTask DisposeAsync()
    {
        cancellation?.Cancel(); cancellation?.Dispose();
        try { await Js.InvokeVoidAsync("SoundScriptTranscription.clear"); }
        catch (JSDisconnectedException) { }
    }
    private async Task ExportSource() => await WithSource(async _ => await Js.InvokeVoidAsync("SoundScriptText.download", Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(source)), "transcription.ss"));
    private async Task ExportReport() => await Js.InvokeVoidAsync("SoundScriptText.download", Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(System.Text.Json.JsonSerializer.Serialize(new { Media = media, Excerpt = new MediaExcerpt(excerptStart,excerptDuration), Generated = generated, Transcription = result, RoundTrip = (object?)percussionComparison ?? (object?)polyphonicComparison ?? comparison }, AnalysisJsonOutput.Options))), "transcription.json");
}
