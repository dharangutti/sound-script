@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SoundScript.Transcription
@using SoundScript.Wave
@using SoundScript.Midi
@using SoundScript.Parser
@inject IJSRuntime Js

<div class="transcription-workspace">
    <h2>Transcribe a melody</h2>
    <p>Import a solo instrument or humming recording, edit the generated SoundScript, and hear it reconstructed. Audio stays in this browser.</p>
    <p>WAV is recommended. MP3 and video support depend on browser codecs; the CLI supports FFmpeg. Maximum 64 MiB / 120 seconds. Use a solo melody; simultaneous sources are unsupported.</p>
    <label for="transcription-file">Media file</label>
    <InputFile id="transcription-file" OnChange="SelectFile" accept="audio/*,video/mp4,video/webm,.wav,.mp3,.mp4,.m4a,.webm" disabled="@busy" />
    <label for="transcription-tempo">Tempo (blank for automatic estimate)</label>
    <input id="transcription-tempo" type="number" min="20" max="300" @bind="tempo" disabled="@busy" />
    <label for="transcription-instrument">Playback instrument</label>
    <select id="transcription-instrument" @bind="instrument" disabled="@busy">
        <option value="73">Flute</option><option value="0">Piano</option><option value="40">Violin</option><option value="80">Synth lead</option>
    </select>
    <div class="playground-playbar">
        <button class="btn btn-primary" disabled="@(busy || file == null)" @onclick="Analyze">@(busy ? "Working…" : "Analyze / Transcribe")</button>
        @if (busy) { <button class="btn btn-secondary" @onclick="Cancel">Cancel analysis</button> }
        <button class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(source))" @onclick="Play">Play edited source</button>
        <button class="btn btn-secondary" @onclick="Stop">Stop</button>
        <button class="btn btn-secondary" disabled="@(busy || string.IsNullOrWhiteSpace(source))" @onclick="ExportSource">Export SoundScript</button>
        <button class="btn btn-secondary" disabled="@(busy || string.IsNullOrWhiteSpace(source))" @onclick="ExportWave">Export WAV</button>
        <button class="btn btn-secondary" disabled="@(busy || result == null)" @onclick="ExportReport">Export analysis</button>
    </div>
    @if (error != null) { <p role="alert">@error</p> }
    <p role="status" aria-live="polite">@status</p>
    @if (result != null)
    {
        <p>@result.Score.Tracks[0].Notes.Count notes · Tempo hypothesis @result.Score.TempoMap[0].Bpm BPM · Pitch periodicity @result.PitchConfidence.ToString("P1") · Timing grid fit @result.TimingGridFit.ToString("P1")</p>
        <ul>@foreach (var diagnostic in result.Diagnostics) { <li>@diagnostic.Message</li> }</ul>
        @if (comparison != null) { <p>Reconstruction check: pitch recall @comparison.PitchAccuracy.ToString("P1"), @comparison.MissedNotes missed, @comparison.ExtraNotes extra notes. This compares the generated score to its rendered audio; it does not prove source accuracy.</p> }
    }
    <label for="transcription-source">Editable SoundScript</label>
    <textarea id="transcription-source" class="transcription-source" rows="18" spellcheck="false" @bind="source" @bind:event="oninput" disabled="@busy"></textarea>
</div>

@code {
    private IBrowserFile? file;
    private int? tempo;
    private int instrument = 73;
    private bool busy;
    private string source = "";
    private string? status, error;
    private TranscriptionResult? result;
    private ComparisonMetrics? comparison;
    private CancellationTokenSource? cancellation;
    private void Cancel() => cancellation?.Cancel();

    private void SelectFile(InputFileChangeEventArgs args) { file = args.File; error = null; status = $"Selected {file.Name}."; }
    private async Task Analyze()
    {
        if (file == null || busy) return;
        busy = true; error = null; status = "Decoding and analyzing melody…";
        result = null; comparison = null;
        cancellation?.Dispose(); cancellation = new CancellationTokenSource();
        try
        {
            await Task.Yield();
            using var input = file.OpenReadStream(64 * 1024 * 1024);
            using var memory = new MemoryStream(); await input.CopyToAsync(memory);
            var bytes = memory.ToArray();
            AnalysisAudio audio;
            if (Path.GetExtension(file.Name).Equals(".wav", StringComparison.OrdinalIgnoreCase))
            {
                try { audio = PcmWaveInput.Decode(bytes); }
                catch (NotSupportedException) { audio = await DecodeBrowser(bytes); }
            }
            else audio = await DecodeBrowser(bytes);
            var observations = await new MonophonicAnalyzer().AnalyzeAsync(audio, cancellation.Token);
            result = new MonophonicTranscriber().Interpret(observations, new(tempo, instrument));
            if (result.Score.Tracks.All(t => t.Notes.Count == 0)) { status = "No stable musical notes found. Try a clear solo melody."; return; }
            status = "Rendering and checking the reconstruction…"; StateHasChanged();
            var validation = await MusicalComparison.ValidateAsync(result.Score, cancellation.Token);
            source = validation.Source; comparison = validation.ScoreToRenderedAudio;
            status = "Ready. Play, edit the source, and play again. Analysis describes the original import.";
        }
        catch (OperationCanceledException) { status = "Analysis cancelled; your editor text is preserved."; }
        catch (Exception ex) { error = ex.Message; status = "Transcription failed; your editor text is preserved."; }
        finally { busy = false; }
    }
    private async Task<AnalysisAudio> DecodeBrowser(byte[] bytes)
    {
        await using var reference = await Js.InvokeAsync<IJSStreamReference>("SoundScriptTranscription.decode", bytes);
        await using var stream = await reference.OpenReadStreamAsync(AnalysisAudio.SampleRate * AnalysisAudio.MaximumSeconds * 4L);
        using var memory = new MemoryStream(); await stream.CopyToAsync(memory);
        var data = memory.ToArray();
        if (data.Length % 4 != 0) throw new InvalidDataException("Partial PCM data returned by browser.");
        var samples = new float[data.Length / 4]; Buffer.BlockCopy(data, 0, samples, 0, data.Length);
        return new(samples);
    }
    private async Task Play() => await WithSource(async bytes => await Js.InvokeVoidAsync("SoundScriptAudio.playWavBytes", bytes));
    private async Task ExportWave() => await WithSource(async bytes => await Js.InvokeVoidAsync("SoundScriptAudio.download", Convert.ToBase64String(bytes), "transcription.wav"));
    private async Task WithSource(Func<byte[], Task> action)
    {
        if (busy) return; busy = true; error = null;
        try { await Task.Yield(); var bytes = WaveRenderer.RenderToBytes(SoundScriptOutput.Parse(source)); await action(bytes); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }
    private async Task Stop() => await Js.InvokeVoidAsync("SoundScriptAudio.stop");
    private async Task ExportSource() => await Js.InvokeVoidAsync("SoundScriptText.download", Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(source)), "transcription.ss");
    private async Task ExportReport() => await Js.InvokeVoidAsync("SoundScriptText.download", Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(System.Text.Json.JsonSerializer.Serialize(new { Transcription = result, RoundTrip = comparison }, AnalysisJsonOutput.Options))), "transcription.json");
}
