<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoundScript.Playground</RootNamespace>
    <AssemblyName>SoundScript.Playground</AssemblyName>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\playground\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundle repository documentation so learning links also work in a standalone Playground publish. -->
    <Content Include="../../docs/**/*.md" Exclude="../../docs/playground/**" Link="wwwroot/learn/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/doc.html" Link="wwwroot/learn/doc.html" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/v14-artifact-hashes.json" Link="wwwroot/learn/v14-artifact-hashes.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/assets/marked.min.js" Link="wwwroot/learn/assets/marked.min.js" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/assets/docs-code.js" Link="wwwroot/learn/assets/docs-code.js" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/assets/docs-code.css" Link="wwwroot/learn/assets/docs-code.css" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/assets/soundscript-logo.png" Link="wwwroot/learn/assets/soundscript-logo.png" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\examples\visual-*.ssv" LogicalName="VisualExamples.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\examples\performance-*.ss" LogicalName="PerformanceExamples.%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="SoundScript.Wordbank.Corpus.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundScript.Core\SoundScript.Core.csproj" />
    <ProjectReference Include="..\SoundScript\SoundScript.csproj" />
    <ProjectReference Include="..\SoundScript.Parser\SoundScript.Parser.csproj" />
    <ProjectReference Include="..\SoundScript.Midi\SoundScript.Midi.csproj" />
    <ProjectReference Include="..\SoundScript.Visual\SoundScript.Visual.csproj" />
    <ProjectReference Include="..\SoundScript.Media\SoundScript.Media.csproj" />
    <ProjectReference Include="..\SoundScript.Voice\SoundScript.Voice.csproj" />
    <ProjectReference Include="..\SoundScript.Compose\SoundScript.Compose.csproj" />
    <ProjectReference Include="..\SoundScript.Timbre\SoundScript.Timbre.csproj" />
    <ProjectReference Include="..\SoundScript.Prosody\SoundScript.Prosody.csproj" />
    <ProjectReference Include="..\SoundScript.Wave\SoundScript.Wave.csproj" />
    <ProjectReference Include="..\SoundScript.Vocal\SoundScript.Vocal.csproj" />
    <ProjectReference Include="..\SoundScript.Transcription\SoundScript.Transcription.csproj" />
  </ItemGroup>

  <!--
    Extended in-browser vocal engine assets. The WordBank corpus (lemmas + audio)
    is copied into wwwroot/vocal-corpus as static web assets so the browser can
    fetch it ON DEMAND when the user enables the vocal engine. It is NOT part of
    the initial download — OFF stays lightweight. Copied at build time (not
    committed) to avoid duplicating the corpus already tracked under
    src/SoundScript.Wordbank/Data.
  -->
  <Target Name="CopyVocalCorpus" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_VocalCorpusAudio Include="..\SoundScript.Wordbank\Data\corpus\v2026.07\audio\en\*.wav" />
    </ItemGroup>
    <Copy SourceFiles="..\SoundScript.Wordbank\Data\corpus\v2026.07\en\lemmas.json" DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\vocal-corpus\en\lemmas.json" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_VocalCorpusAudio)" DestinationFiles="@(_VocalCorpusAudio->'$(MSBuildProjectDirectory)\wwwroot\vocal-corpus\audio\en\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="FlattenPlaygroundPublish" AfterTargets="Publish">
    <!-- Replace the framework generation, including obsolete boot manifests. -->
    <RemoveDir Directories="$(PublishDir)_framework" />
    <ItemGroup>
      <_WwwrootFiles Include="$(PublishDir)wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WwwrootFiles)" DestinationFiles="@(_WwwrootFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <Delete Files="$(PublishDir)web.config" ContinueOnError="true" />
    <Delete Files="$(PublishDir)Melanchall_DryWetMidi_Native32.dll" ContinueOnError="true" />
    <Delete Files="$(PublishDir)Melanchall_DryWetMidi_Native64.dll" ContinueOnError="true" />
    <Delete Files="$(PublishDir)Melanchall_DryWetMidi_Native64.dylib" ContinueOnError="true" />
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)..\..\scripts\verify-playground-integrity.cjs&quot; &quot;$(PublishDir).&quot;" />
  </Target>

</Project>
