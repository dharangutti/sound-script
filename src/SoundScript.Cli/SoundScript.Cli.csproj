<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SoundScript.Core\SoundScript.Core.csproj" />
    <ProjectReference Include="..\SoundScript.Parser\SoundScript.Parser.csproj" />
    <ProjectReference Include="..\SoundScript.Midi\SoundScript.Midi.csproj" />
    <ProjectReference Include="..\SoundScript.Voice\SoundScript.Voice.csproj" />
    <ProjectReference Include="..\SoundScript.Compose\SoundScript.Compose.csproj" />
    <ProjectReference Include="..\SoundScript.Timbre\SoundScript.Timbre.csproj" />
    <ProjectReference Include="..\SoundScript.Prosody\SoundScript.Prosody.csproj" />
    <ProjectReference Include="..\SoundScript.Wave\SoundScript.Wave.csproj" />
    <ProjectReference Include="..\SoundScript.Vocal\SoundScript.Vocal.csproj" />
    <ProjectReference Include="..\SoundScript.Visual\SoundScript.Visual.csproj" />
    <ProjectReference Include="..\SoundScript.Media\SoundScript.Media.csproj" />
    <ProjectReference Include="..\SoundScript.Transcription\SoundScript.Transcription.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>soundscript</AssemblyName>
    <RootNamespace>SoundScript.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>soundscript</ToolCommandName>
    <PackageId>SoundScript.Cli</PackageId>
    <Description>Deterministic audio and temporal media programming, with CLI validation, inspection, and export.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/dharangutti/sound-script</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dharangutti/sound-script.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>music;audio;midi;wav;webm;dsl;deterministic;cli</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundScript\SoundScript.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Debug symbols are useful in build output but are not required by a
       globally installed tool. Remove only PDBs from the PackTool payload;
       publish output, native runtime assets, RIDs, and Wordbank content stay
       unchanged. -->
  <Target Name="ExcludeToolPdbFiles" AfterTargets="PackTool">
    <ItemGroup>
      <TfmSpecificPackageFile Remove="@(TfmSpecificPackageFile)" Condition="'%(TfmSpecificPackageFile.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
