<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseLocalPackage Condition="'$(UseLocalPackage)' == ''">false</UseLocalPackage>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalPackage)' == 'true'">
    <PackageReference Include="SoundScript" Version="13.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalPackage)' != 'true'">
    <ProjectReference Include="../../src/SoundScript/SoundScript.csproj" />
  </ItemGroup>
</Project>
