<Project>
  <!--
    Single source of truth for the SoundScript release version. Bump these
    three properties to cut a release: every project under src/ inherits
    them automatically (standard MSBuild Directory.Build.props discovery),
    VersionInfo.cs (SoundScript.Core) reads them back at runtime, and
    .github/workflows/deploy-pages.yml re-stamps the docs/index.html badge
    from the same values on the next push to main.
  -->
  <PropertyGroup>
    <Version>14.0.0</Version>
    <SoundScriptVersionLabel>V14</SoundScriptVersionLabel>
    <SoundScriptCodename>Programmable Media Runtime</SoundScriptCodename>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Library XML travels with the public package. Existing advanced types
         remain public for compatibility; document entry points incrementally. -->
    <GenerateDocumentationFile Condition="'$(MSBuildProjectName)' != 'SoundScript.Tests' and '$(MSBuildProjectName)' != 'SoundScript.Playground' and '$(MSBuildProjectName)' != 'SoundScript.Web' and '$(MSBuildProjectName)' != 'SoundScript.Cli' and '$(MSBuildProjectName)' != 'SoundScript.Cli.TestFfmpeg'">true</GenerateDocumentationFile>
    <NoWarn Condition="'$(MSBuildProjectName)' != 'SoundScript'">$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SoundScriptVersionLabel" Value="$(SoundScriptVersionLabel)" />
    <AssemblyMetadata Include="SoundScriptCodename" Value="$(SoundScriptCodename)" />
  </ItemGroup>
</Project>
