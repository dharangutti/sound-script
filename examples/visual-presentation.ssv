tempo 120
track explanation0 {  speak "results" seed=7 }
track explanation1 { rest:4 speak "focus" seed=7 }
track explanation2 { rest:8 speak "next" seed=7 }
sync audio

visual "background" for 6s at 0s {
    shape rectangle
    fill "#f1f5f9"
    set x 640
    set y 360
    set width 1280
    set height 720
}

visual "heading" for 6s at 0s {
    shape text
    fill "#0f172a"
    text "QUARTERLY REVIEW"
    fontSize 48
    set x 640
    set y 78
    set width 1100
    set height 62
}

visual "page-0" for 2s at 0s {
    shape text
    fill "#0f172a"
    text "01 / 03"
    fontSize 20
    set x 1110
    set y 140
    set width 160
    set height 34
}

visual "slide-0" for 2s at 0s {
    shape text
    fill "#0f172a"
    text "RELIABILITY IMPROVED"
    fontSize 42
    set x 640
    set y 300
    set width 1100
    set height 56
}

visual "caption-0" for 2s at 0s {
    shape text
    fill "#0f172a"
    text "INCIDENTS DOWN 25%"
    fontSize 28
    set x 640
    set y 640
    set width 1120
    set height 42
}

visual "page-1" for 2s at 2s {
    shape text
    fill "#0f172a"
    text "02 / 03"
    fontSize 20
    set x 1110
    set y 140
    set width 160
    set height 34
}

visual "slide-1" for 2s at 2s {
    shape text
    fill "#0f172a"
    text "FOCUS ON RESPONSE TIME"
    fontSize 42
    set x 640
    set y 300
    set width 1100
    set height 56
}

visual "caption-2" for 2s at 2s {
    shape text
    fill "#0f172a"
    text "TARGET: UNDER 200 MS"
    fontSize 28
    set x 640
    set y 640
    set width 1120
    set height 42
}

visual "page-2" for 2s at 4s {
    shape text
    fill "#0f172a"
    text "03 / 03"
    fontSize 20
    set x 1110
    set y 140
    set width 160
    set height 34
}

visual "slide-2" for 2s at 4s {
    shape text
    fill "#0f172a"
    text "NEXT: AUTOMATE CHECKS"
    fontSize 42
    set x 640
    set y 300
    set width 1100
    set height 56
}

visual "caption-4" for 2s at 4s {
    shape text
    fill "#0f172a"
    text "OWNER: PLATFORM TEAM"
    fontSize 28
    set x 640
    set y 640
    set width 1120
    set height 42
}
