tempo 120

sync audio

visual "background" for 6s at 0s {
    shape rectangle
    fill "#f1f5f9"
    set x 640
    set y 360
    set width 1280
    set height 720
}

visual "heading" for 6s at 0s {
    shape text
    fill "#0f172a"
    text "LATENCY BEFORE AND AFTER"
    fontSize 48
    set x 640
    set y 78
    set width 1100
    set height 62
}

visual "before-label" for 6s at 0s {
    shape text
    fill "#0f172a"
    text "BEFORE: 480 MS"
    fontSize 26
    set x 260
    set y 285
    set width 350
    set height 40
}

visual "after-label" for 4s at 2s {
    shape text
    fill "#0f172a"
    text "AFTER: 160 MS"
    fontSize 26
    set x 260
    set y 455
    set width 350
    set height 40
}

visual "before" for 6s at 0s {
    shape rectangle
    fill "#64748b"
    set x 800
    set y 285
    set width 600
    set height 72
}

visual "after" for 4s at 2s {
    shape rectangle
    fill "#2563eb"
    set y 455
    set height 72
    animate x 504 -> 600 over 2s
    animate width 8 -> 200 over 2s
}

visual "caption-4" for 2s at 4s {
    shape text
    fill "#0f172a"
    text "SAME SCALE - ONE THIRD OF THE LATENCY"
    fontSize 28
    set x 640
    set y 640
    set width 1120
    set height 42
}
