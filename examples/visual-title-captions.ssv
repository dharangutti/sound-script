tempo 120
track sting { instrument piano p C4 h E4 h G4 h C5 h }
sync audio

visual "background" for 6s at 0s {
    shape rectangle
    fill "#17132b"
    set x 640
    set y 360
    set width 1280
    set height 720
}

visual "heading" for 6s at 0s {
    shape text
    fill "#faf5ff"
    text ""
    fontSize 48
    set x 640
    set y 78
    set width 1100
    set height 62
}

visual "title" for 2s at 0s {
    shape text
    fill "#faf5ff"
    text "A SMALL CHANGE"
    fontSize 68
    set x 640
    set y 280
    set width 1060
    set height 82
}

visual "subtitle" for 2s at 0s {
    shape text
    fill "#faf5ff"
    text "CAN MAKE A LARGE DIFFERENCE"
    fontSize 30
    set x 640
    set y 380
    set width 1060
    set height 44
}

visual "middle" for 2s at 2s {
    shape text
    fill "#faf5ff"
    text "MEASURE. LEARN. IMPROVE."
    fontSize 44
    set x 640
    set y 330
    set width 1120
    set height 58
}

visual "end" for 2s at 4s {
    shape text
    fill "#faf5ff"
    text "START WITH ONE EXPERIMENT"
    fontSize 42
    set x 640
    set y 330
    set width 1120
    set height 56
}
