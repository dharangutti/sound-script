tempo 120
track explanation0 {  speak "plan" seed=7 }
track explanation1 { rest:4 speak "build" seed=7 }
track explanation2 { rest:8 speak "ship" seed=7 }
sync audio

visual "background" for 6s at 0s {
    shape rectangle
    fill "#fff7ed"
    set x 640
    set y 360
    set width 1280
    set height 720
}

visual "heading" for 6s at 0s {
    shape text
    fill "#431407"
    text "REQUEST TO DELIVERY"
    fontSize 48
    set x 640
    set y 78
    set width 1100
    set height 62
}

visual "handoff-0" for 5s at 1s {
    shape arrow
    fill "#ea580c"
    set rotation 0.000
    strokeWidth 3
    set x 450
    set y 350
    set width 140.000
    set height 22
}

visual "step-0" for 6s at 0s {
    shape roundedRectangle
    fill "#ffedd5"
    stroke "#9a3412"
    strokeWidth 2
    set x 260
    set y 350
    set width 240
    set height 130
}

visual "step-0-label" for 6s at 0s {
    shape text
    fill "#431407"
    text "PLAN"
    fontSize 26
    set x 260
    set y 350
    set width 216
    set height 40
}

visual "caption-0" for 2s at 0s {
    shape text
    fill "#431407"
    text "AGREE THE OUTCOME"
    fontSize 28
    set x 640
    set y 640
    set width 1120
    set height 42
}

visual "handoff-1" for 3s at 3s {
    shape arrow
    fill "#ea580c"
    set rotation 0.000
    strokeWidth 3
    set x 830
    set y 350
    set width 140.000
    set height 22
}

visual "step-1" for 4s at 2s {
    shape roundedRectangle
    fill "#ffedd5"
    stroke "#9a3412"
    strokeWidth 2
    set x 640
    set y 350
    set width 240
    set height 130
}

visual "step-1-label" for 4s at 2s {
    shape text
    fill "#431407"
    text "BUILD"
    fontSize 26
    set x 640
    set y 350
    set width 216
    set height 40
}

visual "caption-2" for 2s at 2s {
    shape text
    fill "#431407"
    text "BUILD AND CHECK"
    fontSize 28
    set x 640
    set y 640
    set width 1120
    set height 42
}

visual "step-2" for 2s at 4s {
    shape roundedRectangle
    fill "#ffedd5"
    stroke "#9a3412"
    strokeWidth 2
    set x 1020
    set y 350
    set width 240
    set height 130
}

visual "step-2-label" for 2s at 4s {
    shape text
    fill "#431407"
    text "SHIP"
    fontSize 26
    set x 1020
    set y 350
    set width 216
    set height 40
}

visual "caption-4" for 2s at 4s {
    shape text
    fill "#431407"
    text "DELIVER WITH CONFIDENCE"
    fontSize 28
    set x 640
    set y 640
    set width 1120
    set height 42
}
