tempo 120

track music {
    instrument piano
    mf
    C4 h E4 h G4 h C5 h
    G4 h E4 h C4 h G4 h
    C5 h G4 h E4 h C4 h
}

sync audio
visual "intro" for 3s
wait 1s
visual "product" for 4s
visual "circle" for 8s at 0s {
    animate radius 28 -> 170 over 3s
    animate opacity 0.35 -> 1 over 1.5s
}
visual "sparkle" for 2s at 4.5s {
    animate opacity 0 -> 1 over 0.4s
}
visual "outro" for 4s {
    animate opacity 1 -> 0 over 2s
}
