{
  "width": 480,
  "height": 270,
  "fps": 30,
  "frames": 60,
  "parameters": {
    "musicGain": {
      "default": 0.15,
      "min": 0,
      "max": 1
    }
  },
  "typedParameters": {
    "audience": {
      "type": "enum",
      "default": "shopfloor",
      "values": [
        "shopfloor",
        "qa",
        "engineering"
      ]
    },
    "showSafety": {
      "type": "boolean",
      "default": true
    }
  },
  "groups": {
    "shopfloor": {
      "when": "audience == 'shopfloor'"
    },
    "qa": {
      "when": "audience == 'qa'"
    },
    "engineering": {
      "when": "audience == 'engineering'"
    }
  },
  "videos": [
    {
      "asset": "../web/samples/assembly.mp4",
      "trim": 0,
      "frames": 60,
      "transform": {
        "opacity": 1
      }
    }
  ],
  "audio": [
    {
      "asset": "../web/samples/calm.wav",
      "trim": 0,
      "frames": 60,
      "at": 0,
      "gain": "musicGain"
    }
  ],
  "shapes": [
    {
      "group": "shopfloor",
      "at": 0,
      "frames": 60,
      "width": 456,
      "height": 4,
      "color": "F4C95D",
      "transform": {
        "x": 12,
        "y": 104
      }
    },
    {
      "group": "qa",
      "at": 0,
      "frames": 60,
      "width": 456,
      "height": 4,
      "color": "6EE7B7",
      "transform": {
